# ============================================
#   🚀 立即开始 - 无需API密钥！
# ============================================

# 选择以下任一模式（取消注释即可）：

# ✅ 方案A: 演示模式（推荐新手，无需任何配置）
OPENAI_API_KEY=demo

# ✅ 方案B: Ollama本地模型（需先安装Ollama）
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL=qwen2.5:3b

# 通用配置
MAX_TOKENS=2048
TEMPERATURE=0.7
MAX_RETRIES=3
RETRY_DELAY=1
